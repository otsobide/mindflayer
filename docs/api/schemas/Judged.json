            "code": {
              "const": "name_empty"
            },
            "message": {
              "type": "string"
            },
            "warning": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "warning",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
