{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Library",
  "description": "The workspace's own artifacts, held as a project holds its own.",
  "type": "object",
  "properties": {
    "artifacts": {
      "description": "Each of its own, by kind and then name: no project's, so none\nstands in a state, and nothing is installed into them.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Held"
      }
    },
    "directories": {
      "description": "Where it keeps each kind, as a route from the workspace's root.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Directory"
      }
    },
    "failures": {
      "description": "What could not be read in it and is no artifact's: a folder that\ncannot be listed, its templates.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Said"
      }
    },
    "holders": {
      "description": "Each project its registry links that holds a copy of one of its own,\nin the order of `artifacts`, then of the registry.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/LibraryHolder"
      }
    },
    "origin": {
      "description": "What `--from` takes for each of its own, and what an install of one\nrecords as its origin: so a front end names it in a command line by\ncore's word rather than by one of its own that core could spell\ndifferently.",
      "type": "string"
    },
    "servers": {
      "description": "Each of its own MCP servers whose definition reads, in the order\nof `artifacts`, as each agent would be given it: what a page of\nservers shows beside each one's row of `artifacts`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/LibraryServer"
      }
    },
    "templates": {
      "description": "What `mindweaver add --template` can start from.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Template"
      }
    }
  },
  "required": [
    "origin",
    "directories",
    "artifacts",
    "holders",
    "templates",
    "failures",
    "servers"
  ],
  "$defs": {
    "Agent": {
      "description": "A coding agent, by the name `--agents` and a project's settings take.",
      "type": "string",
      "enum": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "Directory": {
      "description": "Where a holder keeps one kind.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "path": {
          "description": "A route from the holder, `/` separated, or the path itself when no\nroute leads there.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ]
    },
    "Given": {
      "description": "How an agent starts an MCP server, or reaches one: a program or an\naddress, never both.\n\nIn JSON, what a front end sends a command line's options as, and what\nthe snapshot says a definition is told as: tagged by `type` inside the\nobject, `{\"type\": \"program\", \"command\": \"npx\", ...}`, as a task is, each\npair as an array of its two words. A field it does not have is refused,\nas a task's is: it is a write, and one misspelled would be dropped.\nEvery secret is the name of the variable it is read from, and no field\nholds a secret's value, there being none for it to hold.",
      "oneOf": [
        {
          "description": "A program an agent starts, `--command`.",
          "type": "object",
          "properties": {
            "arg_env": {
              "description": "Each argument read from a variable, after those written as they are\n(`--arg-env VAR`). No secret: a program's arguments are what a\nprocess list shows, and Codex reads no secret into one.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "args": {
              "description": "What it is started with, in order (`--arg`), before every argument\nread from a variable.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "command": {
              "description": "The program, as the agent finds it (`--command`).",
              "type": "string"
            },
            "env": {
              "description": "What its environment is given, each value as written (`--env\nK=V`), before every secret.",
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            },
            "secret_env": {
              "description": "Each variable passed on to its environment under its own name, a\nsecret (`--secret-env VAR`): the shape every agent can give one,\nCodex's `env_vars` among them.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "program"
            }
          },
          "required": [
            "type",
            "command",
            "args",
            "env",
            "secret_env",
            "arg_env"
          ]
        },
        {
          "description": "A server at an address, `--url`.",
          "type": "object",
          "properties": {
            "bearer": {
              "description": "The variable `Authorization: Bearer` is followed by, a secret\n(`--bearer-env VAR`): what Codex reads one into\n(`bearer_token_env_var`).",
              "type": [
                "string",
                "null"
              ]
            },
            "events": {
              "description": "Whether it is reached over server-sent events rather than streamable\nHTTP (`--sse`).",
              "type": "boolean"
            },
            "headers": {
              "description": "What every request carries, each value as written (`--header K=V`),\nbefore every secret.",
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            },
            "secret_headers": {
              "description": "Each header whose whole value is read from a variable, a secret\n(`--secret-header H=VAR`): what Codex reads one into\n(`env_http_headers`).",
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            },
            "type": {
              "type": "string",
              "const": "address"
            },
            "url": {
              "description": "Where the server is, as typed (`--url`): checked for a credential\nbefore anything is written, since the file would keep one, and\nnever kept or said whole once one is found.",
              "type": "string"
            },
            "url_vars": {
              "description": "Each part of the address read from a variable, by the name the\naddress writes between braces where it goes (`--url-var NAME=VAR`).\nNo secret: an address is what a log or a proxy shows, and Codex\nreads no secret into one.",
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            }
          },
          "required": [
            "type",
            "url",
            "events",
            "headers",
            "secret_headers",
            "bearer",
            "url_vars"
          ]
        }
      ]
    },
    "GivenTo": {
      "description": "How one agent would be given an MCP server: what it cannot be given of\nit, what its entry would run or reach, and what it asks before it\nstarts one.",
      "type": "object",
      "properties": {
        "agent": {
          "$ref": "#/$defs/Agent"
        },
        "dropped": {
          "description": "What its entry would be written without, as `show` says it.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Said"
          }
        },
        "refused": {
          "description": "Why it would be given none of it, each by its code and in its\nwords: what it cannot be given at all, as `show` says it, or else\nwhy its renderer writes it no entry, an input read from no\nvariable. Empty, and it is given an entry.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Said"
          }
        },
        "runs": {
          "description": "What its entry would run or reach, as the entry spells it; none\nwhen it is refused.",
          "anyOf": [
            {
              "$ref": "#/$defs/Running"
            },
            {
              "type": "null"
            }
          ]
        },
        "starts": {
          "description": "What it asks before it starts a server a project gives it.",
          "$ref": "#/$defs/Starts"
        }
      },
      "required": [
        "agent",
        "refused",
        "dropped",
        "runs",
        "starts"
      ]
    },
    "Held": {
      "description": "One artifact a holder holds, and how it stands there.",
      "type": "object",
      "properties": {
        "agents": {
          "description": "The agents among its project's that read a copy of it, in report\norder.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Agent"
          }
        },
        "issues": {
          "description": "Everything `validate` says of it, warnings included, each saying\nwhether it is one.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          }
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "name": {
          "type": "string"
        },
        "origin": {
          "description": "Where what was installed came from, as `--from` takes it.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "description": "How its name stands in its project, as `status` says; none for the\nlibrary's own, which are no project's. Only a copy that reads has a\nstanding, so beside an [`unread`](Self::unread) one it is that of a\ncopy of the name elsewhere, in an agent's folder, and none when\nthere is no such copy.",
          "anyOf": [
            {
              "$ref": "#/$defs/State"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "description": "The one line a listing shows; none for one whose file does not read,\nand for an install nothing of which is found.",
          "type": [
            "string",
            "null"
          ]
        },
        "targets": {
          "description": "Where it is held, as routes from its holder, `/` separated, in path\norder: each copy discovery found, the one whose file does not read\namong them, and each place the ledger records putting one, found or\nnot.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unread": {
          "description": "The copy whose file does not read, when one does not, and why.\nListed all the same, by the name its place gives it, because a file\nthat does not read is the one most in need of opening.",
          "anyOf": [
            {
              "$ref": "#/$defs/Unread"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "summary",
        "state",
        "agents",
        "origin",
        "targets",
        "issues",
        "unread"
      ]
    },
    "Kind": {
      "description": "A kind of artifact, by the word a command line takes for it.",
      "type": "string",
      "enum": [
        "skill",
        "rule",
        "mcp"
      ]
    },
    "LibraryHolder": {
      "description": "A project holding a copy of one of the workspace's own: one whose install\nthe ledger tells came from it ([`install::from_the_library`]), the rule\n`mindweaver remove --everywhere` takes the copies it removes by.\n\nTold here rather than by a front end comparing a copy's\n[`origin`](Held::origin) with [`Library::origin`], which would be a\nrule of its own, and a different one: a record from before origins were\nkept names none, and is a copy of one of the workspace's own all the\nsame while no workspace it loads offers that name.",
      "type": "object",
      "properties": {
        "entry": {
          "description": "The project, as its registry entry spells it ([`Project::entry`]):\nits artifact of that kind and name is the copy. Each entry that\nspells one directory is a holder of its own, as each is a project\nof the snapshot's.",
          "type": "string"
        },
        "kind": {
          "description": "The one of the workspace's own it holds a copy of.",
          "$ref": "#/$defs/Kind"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "entry"
      ]
    },
    "LibraryServer": {
      "description": "One of the workspace's own MCP servers, as `add mcp` would be told to\nwrite it and as each agent would be given it.\n\nWorked out here, from each agent's renderer, rather than by a front end\nfrom the definition: what an agent runs is what its own entry spells\n([`mcp::Runs`]), an input reaching Claude as `${VAR}` and OpenCode as\n`{env:VAR}`, and what it cannot be given is core's report of it\n([`McpDefinition::expressibility`]).",
      "type": "object",
      "properties": {
        "agents": {
          "description": "How each agent would be given it, in report order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GivenTo"
          }
        },
        "given": {
          "description": "How it is started or reached, as `add mcp`'s options would say it\n([`mcp::Given::of`]), for a form changing it to start from: none\nwhen the definition holds what no option says, which is changed as\ntext.",
          "anyOf": [
            {
              "$ref": "#/$defs/Given"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "given",
        "agents"
      ]
    },
    "Running": {
      "description": "What an agent runs or reaches, as a front end shows it: whether it is\nan address rather than a program, and the line, as [`Runs`] displays\nit, each word a shell would split quoted.\n\nThe line as core writes it rather than the words for a front end to\njoin, which would be the shell's quoting spelled again in TypeScript,\nand could show a line no shell reads as the program it is.",
      "type": "object",
      "properties": {
        "line": {
          "description": "The program as a shell line that runs it, or the address.",
          "type": "string"
        },
        "reaches": {
          "description": "Whether it reaches an address, which it then is, rather than\nstarting a program.",
          "type": "boolean"
        }
      },
      "required": [
        "reaches",
        "line"
      ]
    },
    "Said": {
      "description": "An error as a serialized type holds one: its code, for a front end to act\non, and its message, for whoever reads it.\n\nBuilt where the type is serialized, or kept in what a front end reads\n(the workspace's snapshot), in place of the error, since an error\nholds what JSON has no shape for (an `io::Error`, a parser's own), and\nonly these two are meant to leave core. Its fields are public for a\nfront end that reads the snapshot as Rust rather than as JSON, the TUI.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "description": "Written through [`redacted`](crate::url::redacted), as every URL\nis: an error can quote one, a source's among them, and what built\nthe error is no promise that it carries no credential.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "Starts": {
      "description": "What an agent asks before it starts an MCP server its project's config\nfile gives it ([`Agent::starts_a_server`]).\n\nBy its name in snake_case in JSON, `\"once_approved\"`: a word of core's\na front end says in words of its own, as it says a state, and no word a\ncommand line takes, so derived.",
      "oneOf": [
        {
          "description": "Once somebody approves the project's servers when it asks; a run\nwith no one to ask starts them all the same.",
          "type": "string",
          "const": "once_approved"
        },
        {
          "description": "Only in a project its user's config marks trusted.",
          "type": "string",
          "const": "in_a_trusted_project"
        },
        {
          "description": "With nothing asked.",
          "type": "string",
          "const": "unasked"
        }
      ]
    },
    "State": {
      "description": "How an artifact stands in a project, as `status` says it.",
      "type": "string",
      "enum": [
        "current",
        "outdated",
        "edited",
        "missing",
        "orphaned",
        "foreign",
        "authored"
      ]
    },
    "Template": {
      "description": "A template `mind add` can start from.\n\nWhat it serializes to is a contract, as a status report's is: each field\nby its name.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "name": {
          "type": "string"
        },
        "origin": {
          "description": "The folder or file it is, or none for one built in.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "kind",
        "origin"
      ]
    },
    "Unread": {
      "description": "A copy of an artifact whose file does not read, and why.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "description": "The reason alone, without the path, which [`path`](Self::path)\nsays: written through [`redacted`](crate::url::redacted), as a\n[`Said`]'s message is.",
          "type": "string"
        },
        "path": {
          "description": "Where the copy is, as a route from its holder, `/` separated: its\nplace in the folder the holder keeps its kind in, the one place a\nfile that does not read is named by ([`lifecycle::identify`]). Said\non its own, as well as among [`Held::targets`], since a copy that\nreads can sit beside it under the same name, elsewhere.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "code",
        "message"
      ]
    },
    "ValidationIssue": {
      "description": "Something that stops an artifact from being usable, or will: its code,\nwhat it is about, whether it is only worth a warning, and its message.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "name_empty"
            },
            "message": {
              "type": "string"
            },
            "warning": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "warning",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "name_not_kebab_case"
            },
            "message": {
              "type": "string"
            },
            "segment": {
              "type": "string"
            },
            "warning": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "segment",
            "warning",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "name_segment_too_long"
            },
            "length": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "message": {
              "type": "string"
            },
            "segment": {
              "type": "string"
            },
            "warning": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "segment",
            "length",
            "warning",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "name_directory_mismatch"
            },
            "directory": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "warning": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "name",
            "directory",
            "warning",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "name_file_mismatch"
            },
            "file": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "warning": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "name",
            "file",
            "warning",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "description_empty"
            },
            "message": {
              "type": "string"
            },
            "warning": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "warning",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "description_too_long"
            },
            "length": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "message": {
              "type": "string"
            },
            "warning": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "length",
            "warning",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "compatibility_empty"
            },
            "message": {
              "type": "string"
            },
            "warning": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "warning",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "compatibility_too_long"
            },
            "length": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "message": {
              "type": "string"
            },
            "warning": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "length",
            "warning",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "compatibility_not_a_string"
            },
            "message": {
              "type": "string"
            },
            "warning": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "warning",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "metadata_not_a_map"
            },
            "message": {
              "type": "string"
            },
            "warning": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "warning",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "metadata_not_a_string"
            },
            "key": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "warning": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "key",
            "warning",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "metadata_repeated"
            },
            "key": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "warning": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "key",
            "warning",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "content_empty"
            },
            "message": {
              "type": "string"
            },
            "warning": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "warning",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "front_matter_unparsed"
            },
            "message": {
              "type": "string"
            },
            "reason": {
              "type": "string"
